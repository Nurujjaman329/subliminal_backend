# Port number (public: https://nurujjaman8080.sobhoy.com)
PORT=8080

# URL of the Mongo DB (Atlas) — put your db name after .net/
MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/subliminal?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/subliminal?retryWrites=true&w=majority

NODE_ENV=development
# NODE_ENV=production

# JWT secret key
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRATION_MINUTES=30000
JWT_REFRESH_EXPIRATION_DAYS=30000
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10
# JWT_EXPIRES_IN=7d

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# Bind address
BACKEND_IP=0.0.0.0

# Public backend URL
APP_URL=https://nurujjaman8080.sobhoy.com
# APP_URL=http://localhost:8080

# Admin frontend
FRONTEND_URL=http://localhost:3002
CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

UPLOAD_DIR=uploads

SEED_ADMIN_EMAIL=admin@subliminal.local
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Demo Admin
